{
  "manifest_version": 3,
  "name": "LingQ Click Translator",
  "version": "0.3.13",
  "description": "Click any word on any web page to look up or create a LingQ and see its translation as a tooltip.",
  "permissions": ["storage", "tabs", "alarms", "clipboardWrite", "webNavigation"],
  "host_permissions": [
    "https://www.lingq.com/*",
    "https://lingq.com/*",
    "https://*.supabase.co/*",
    "https://api.openai.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "LingQ Click Translator"
  },
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["role.js", "sites.js", "import-lock.js", "i18n.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["locales/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}

